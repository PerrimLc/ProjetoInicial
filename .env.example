VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Groq API Key — obtenha grátis em https://console.groq.com/keys
VITE_GROQ_API_KEY=

# Opcional: "true" pra rodar o front contra os emuladores locais do Firebase
# (firebase emulators:start --only functions,firestore) em vez do projeto
# real. Deixe em branco/false pra usar o Firebase de verdade normalmente.
VITE_USE_FIREBASE_EMULATOR=
